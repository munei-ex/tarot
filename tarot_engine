                            <div className="text-xs font-bold text-slate-400 mb-2 uppercase">
                                {index === 0 ? "Past" : index === 1 ? "Present" : "Future"}
                            </div>
                            {card ? (
                                <div className="relative group cursor-pointer" onClick={() => selectManualCard(index, null)}>
                                    <div className="w-24 h-40 bg-amber-50 border-2 border-amber-200 rounded flex items-center justify-center overflow-hidden">
                                         {/* 簡易表示 */}
                                         <div className="text-center p-1">
                                             <div className="text-xl mb-1">{card.sign || '🎴'}</div>
                                             <div className="text-xs font-bold leading-tight">{card.nameJP}</div>
                                         </div>
                                    </div>
                                    <div className="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white text-xs rounded transition-opacity">
                                        解除
                                    </div>
                                </div>
                            ) : (
                                <div className="w-24 h-40 border-2 border-dashed border-slate-300 rounded flex items-center justify-center text-slate-300 text-xs text-center p-2">
                                    {searchTerm ? "リストから選択" : "カード未選択"}
                                </div>
                            )}
                        </div>
                    ))}
                </div>

                <div className="flex justify-center">
                    <button 
                        onClick={handleManualAnalyze}
                        disabled={manualSelection.some(c => c === null)}
                        className={`px-8 py-3 rounded-full font-bold flex items-center gap-2 transition-all ${
                            manualSelection.some(c => c === null) 
                            ? 'bg-slate-200 text-slate-400 cursor-not-allowed' 
                            : 'bg-indigo-600 text-white hover:bg-indigo-700 shadow-lg'
                        }`}
                    >
                        <span>結果を分析する</span>
                        <ArrowRight className="w-4 h-4" />
                    </button>
                </div>
             </div>
          </div>
        )}

        {/* RESULT MODE */}
        {mode === 'result' && (
            <SpreadResult 
                cards={drawnCards} 
                onReset={() => {
                    setDrawnCards([]);
                    setManualSelection([null, null, null]);
                    setMode('menu');
                }} 
            />
        )}

      </main>

      {/* Footer info */}
      <footer className="fixed bottom-0 w-full py-2 bg-white/80 backdrop-blur border-t border-slate-100 text-center text-[10px] text-slate-400">
         Data structure based on searge/tarot • Images from Wikimedia Commons (Rider-Waite-Smith / Public Domain)
      </footer>
    </div>
  );
};

export default TarotApp;
