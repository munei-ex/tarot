// 小アルカナの生成ヘルパー
const SUITS = [
  { name: 'Wands', nameJP: 'ワンド', icon: '♣️', abbr: 'w', type: 'fire' },
  { name: 'Cups', nameJP: 'カップ', icon: '♥️', abbr: 'c', type: 'water' },
  { name: 'Swords', nameJP: 'ソード', icon: '♠️', abbr: 's', type: 'air' },
  { name: 'Pentacles', nameJP: 'ペンタクル', icon: '♦️', abbr: 'p', type: 'earth' },
];

const RANKS = [
  { name: 'Ace', val: 1 }, { name: 'Two', val: 2 }, { name: 'Three', val: 3 }, { name: 'Four', val: 4 },
  { name: 'Five', val: 5 }, { name: 'Six', val: 6 }, { name: 'Seven', val: 7 }, { name: 'Eight', val: 8 },
  { name: 'Nine', val: 9 }, { name: 'Ten', val: 10 }, { name: 'Page', val: 11 }, { name: 'Knight', val: 12 },
  { name: 'Queen', val: 13 }, { name: 'King', val: 14 }
];

const generateMinorArcana = () => {
  let cards = [];
  SUITS.forEach(suit => {
    RANKS.forEach(rank => {
      // 画像ファイル名のマッピングロジック (Wikimedia Commonsの命名規則に準拠)
      let imgName = `${suit.name}${rank.val < 10 && rank.val > 1 ? '0' : ''}`;
      if (rank.val === 1) imgName = `${suit.name}01`;
      else if (rank.val === 10) imgName = `${suit.name}10`;
      else if (rank.val > 10) imgName = `${suit.name}${rank.name}`;
      else imgName = `${suit.name}0${rank.val}`;

      // 特殊な命名規則の修正 (Rider-Waite deck on Commons)
      let commonImgKey = `${suit.name}_${rank.val}`;
      if (rank.val > 10) commonImgKey = `${suit.name}_${rank.name}`;
      
      cards.push({
        id: `${suit.abbr}${rank.val}`,
        name: `${rank.name} of ${suit.name}`,
        nameJP: `${suit.nameJP}の${rank.name}`,
        number: rank.val,
        sign: suit.icon, // スートのアイコンをSignとして代用
        arcana: 'Minor',
        suit: suit.name,
        keywords: `${suit.nameJP}のエネルギー, ${rank.name}の意味`,
        imgKey: `RWS_Tarot_${suit.name}_${rank.name === 'Ace' ? 'Ace' : (rank.val <= 10 ? String(rank.val).padStart(2, '0') : rank.name)}` 
      });
    });
  });
  return cards;
};

const FULL_DECK = [...MAJOR_ARCANA, ...generateMinorArcana()];

// WikiCommonsから画像URLを取得するヘルパー
const getCardImageUrl = (card) => {
    // いくつかの命名パターンの揺らぎを吸収
    let filename = card.imgKey;
    if(card.arcana === 'Minor') {
       // マイナーアルカナのファイル名生成 (簡易化)
       const rankStr = card.number <= 10 ? String(card.number).padStart(2, '0') : card.name.split(' ')[0];
       filename = `RWS_Tarot_${card.suit}_${rankStr}`;
       if(card.number === 1) filename = `RWS_Tarot_${card.suit}_Ace`;
    }
    return `https://upload.wikimedia.org/wikipedia/commons/d/de/${filename}.jpg`;
    // 実際にはWikimediaのリダイレクトや正確なハッシュパスが必要な場合があるため、
    // ここではより確実なAPIがない限りプレースホルダーまたはCSS描画にフォールバックするロジックが理想的ですが、
    // 視覚的インパクトのため、一旦推測されるWikimediaパスを使用します。
    // ※ リンク切れ対策として、エラーハンドリングをImageコンポーネント側で行います。
};


